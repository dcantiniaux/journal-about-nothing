---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { catName, catUrl, TAGS, dateLong, iso, type Post } from "../lib/site";
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const cats = d.categories.filter((c) => c !== "non-classe");
const tags = d.tags.map((t) => ({ href: "/tag/" + t + "/", name: TAGS[t] ?? t }));
const comments = d.comments;
const ids = new Set(comments.map((c) => c.id));
const shown = comments.map((c) => ({
  ...c,
  reply: c.parent !== "0" && ids.has(c.parent),
  when: dateLong(new Date(c.date + "Z")),
  paras: c.text.split(/\n{2,}/),
}));
const updated = d.updated && iso(d.updated) !== iso(d.date) ? dateLong(d.updated) : null;
const comLabel = comments.length > 1 ? `${comments.length} commentaires publiés` : "1 commentaire publié";
---
<Base title={d.title} description={d.accroche ?? d.excerpt} image={d.image} compact>
  <article>
    <header class="post-head">
      <div class="cats">
        {cats.map((c) => <a class="tag mono" href={catUrl(c)}>{catName(c)}</a>)}
      </div>
      <h1>{d.title}</h1>
      <div class="meta mono">
        <time datetime={iso(d.date)}>{dateLong(d.date)}</time>
        <span>{d.readingTime} min de lecture</span>
        {updated && <span>Mis à jour le {updated}</span>}
      </div>
    </header>
    {d.image && <figure class="ph hero"><img src={d.image} alt="" loading="eager" /></figure>}
    <div class="prose"><Content /></div>

    {tags.length > 0 && (
      <nav class="post-tags" aria-label="Étiquettes">
        {tags.map((t) => <a class="chip" href={t.href}>{t.name}</a>)}
      </nav>
    )}

    {shown.length > 0 && (
      <section class="comments" aria-labelledby="com-title">
        <h2 id="com-title">Commentaires</h2>
        <p class="mono">Archives : {comLabel} sur l’ancien site. Les commentaires sont fermés.</p>
        {shown.map((c) => (
          <article class:list={["comment", { reply: c.reply }]}>
            <header><strong>{c.author}</strong><time class="mono" datetime={c.date}>{c.when}</time></header>
            {c.paras.map((para) => <p>{para}</p>)}
          </article>
        ))}
      </section>
    )}

    <nav class="post-nav" aria-label="Autres textes">
      {older ? (
        <a href={older.data.path}><span class="mono">← Texte précédent</span><span>{older.data.title}</span></a>
      ) : (
        <span></span>
      )}
      {newer && (
        <a class="next" href={newer.data.path}><span class="mono">Texte suivant →</span><span>{newer.data.title}</span></a>
      )}
    </nav>
  </article>
</Base>
